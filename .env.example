DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
CRON_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@example.com
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_TOKEN=

# AUTO: the app fetches and tracks historical/current prices. Users enter trade details and can correct broker fills.
MARKET_DATA_MODE=PROVIDER
# Development may use mock. Production may use "http" with a licensed quote service.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_HTTP_BASE_URL=
MARKET_DATA_HTTP_TOKEN=

# Search visibility: keep FALSE on staging and until legal, privacy, brand and public content review.
PUBLIC_INDEXING_ENABLED=false
# Readiness flag shown in /admin/seo. Set to true only once accurate terms, privacy and support pages are published.
LEGAL_PUBLIC_PAGES_VERIFIED=false
# Public product brand is Wealtharr. The GitHub repository is Ricas13/wealtharr; 9Sig remains a strategy.
NEXT_PUBLIC_BRAND_NAME=Wealtharr
# Mark true only after independent trademark/domain conflict screening.
BRAND_CLEARANCE_VERIFIED=false
# Google Search Console HTML verification token (optional).
GOOGLE_SITE_VERIFICATION=

# Oracle Docker database: set POSTGRES_PASSWORD and a matching URL-encoded DATABASE_URL
# using hostname db; do not expose PostgreSQL on the public interface.
POSTGRES_PASSWORD=

# Optional but strongly recommended: encrypted daily offsite backups.
# Enable using docker compose --profile backups after restic repository initialization.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Set true ONLY after signed paid-launch acceptance, never in staging.
WEALTHARR_PAID_LAUNCH_ENABLED=false

# Number of reverse proxies in front of the app; rate limits key on the address they appended.
TRUSTED_PROXY_HOPS=1
# Largest believable price move versus the previous quote (0.5 = 50%); bigger moves are rejected.
MARKET_MAX_QUOTE_MOVE=0.5

# Set to true once every admin has turned on two-step sign-in (Settings > Security).
ADMIN_MFA_REQUIRED=false

# Sign in with Google / Apple. A button appears only when the provider is fully configured.
# Redirect URIs to register with each provider: <public https origin>/api/auth/callback/google and /apple.
# Set AUTH_URL to that public origin in production so the redirect URI Auth.js sends matches exactly.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
# Either a ready-made Apple client secret (JWT, max 6 months) ...
AUTH_APPLE_SECRET=
# ... or the pieces to generate one at start-up (restart at least every ~5 months):
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
